    -- Все не-игровые персонажи (с Humanoid) в радиусе от точки
    local function nonPlayerHumanoidModels(center, radius)
        local out = {}
        pcall(function()
            local near = workspace:GetPartBoundsInRadius(center, radius)
            local seen = {}
            for _, p in ipairs(near) do
                local m = p:FindFirstAncestorOfClass("Model")
                if m and not seen[m] and m ~= player.Character then
                    seen[m] = true
                    local h = m:FindFirstChildOfClass("Humanoid")
                    local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                    if h and r and not isOtherPlayerChar(m) then
                        out[m] = {hum = h, root = r}
                    end
                end
            end
        end)
        return out
    end

    -- Сидит ли в нашей машине кто-то (пассажир)
    local function passengerInCar()
        local model, seat = getVehicle()
        if not seat then return false end

        local connected = {}
        pcall(function()
            for _, p in ipairs(seat:GetConnectedParts(true)) do
                connected[p] = true
            end
        end)

        for _, info in pairs(nonPlayerHumanoidModels(seat.Position, 25)) do
            local sp = info.hum.SeatPart
            if sp and (sp == seat or connected[sp] or (model and sp:IsDescendantOf(model))) then
                return true
            end
        end
        return false
    end

    -- Наблюдатель: возвращает строку с причиной, когда пассажир сел/вышел/задание сменилось
    local function makeWatcher(best, firstKey, hadHud)
        local startSeated = passengerInCar()
        local sample1, baseline = nil, nil
        local sampleAt = 0
        local lastCheck = 0
        local result = nil

        return function()
            if result then return result end
            if os.clock() - lastCheck < 0.12 then return nil end
            lastCheck = os.clock()

            -- 1) задание на экране
            local instr, hud = readHud()
            if hadHud and not hud then
                result = "задание пропало"
                return result
            end
            if instr and firstKey ~= "" and normText(instr) ~= firstKey then
                result = "задание сменилось"
                return result
            end

            -- 2) метка в мире
            local o = best.obj
            if not o or not o.Parent then
                result = "метка исчезла"
                return result
            end
            if o:IsA("BillboardGui") and not o.Enabled then
                result = "метка исчезла"
                return result
            end

            -- 3) пассажир сел / вышел
            local seated = passengerInCar()
            if seated ~= startSeated then
                result = seated and "пассажир сел" or "пассажир вышел"
                return result
            end

            -- 4) тот, кто стоял в кольце, пропал или ушёл
            local _, seat = getVehicle()
            if seat and (seat.Position - best.pos).Magnitude < 18 then
                if not sample1 then
                    sample1 = {}
                    for m, info in pairs(nonPlayerHumanoidModels(best.pos, 14)) do
                        sample1[m] = {root = info.root, pos = info.root.Position}
                    end
                    sampleAt = os.clock()
                elseif not baseline then
                    if os.clock() - sampleAt > 0.6 then
                        baseline = {}
                        for m, s in pairs(sample1) do
                            -- берём только тех, кто стоит на месте
                            if m.Parent and s.root.Parent
                                and (s.root.Position - s.pos).Magnitude < 1.5 then
                                baseline[m] = {root = s.root, pos = s.root.Position}
                            end
                        end
                    end
                else
                    for m, s in pairs(baseline) do
                        if not m.Parent or not s.root.Parent
                            or (s.root.Position - s.pos).Magnitude > 8 then
                            result = "пассажира забрали"
                            return result
                        end
                    end
                end
            end

            return nil
        end
    end

    local function waitSignal(watcher, timeout, myCycle)
        local t0 = os.clock()
        while alive(myCycle) and os.clock() - t0 < timeout do
            local r = watcher()
            if r then return r end
            task.wait(0.1)
        end
        return nil
    end

    ---------------- режим: такси ----------------
    local function taxiLoop(myCycle)
        timer.Text = "Таймер: --:--"
        local shiftDone = false
        local shiftAttempts = 0
        local shiftMisses = 0
        local lastDone = nil -- {pos, t}

        while alive(myCycle) do
            local _, seat = getVehicle()

            if not seat then
                releaseAll()
                if getCar(myCycle) then
                    setStatus("в машине")
                    task.wait(1)
                else
                    task.wait(4)
                end

            elseif not shiftDone then
                local shift = findPromptBy(function(o) return o.ActionText == ACTION_SHIFT end)

                if not shift then
                    shiftMisses += 1
                    setStatus("стойка не найдена (" .. shiftMisses .. "/2)")
                    if shiftMisses >= 2 then
                        shiftDone = true
                        setStatus("считаем, что смена уже идёт")
                    end
                    task.wait(2)
                else
                    shiftMisses = 0
                    local part = getPromptPart(shift)

                    if part then
                        setStatus("к стойке такси")
                        local arrived = travelTo(part.Position, myCycle, 6)

                        if arrived and alive(myCycle) then
                            shiftAttempts += 1
                            if activatePrompt(shift) then
                                setStatus("смена начата")
                                shiftDone = true
                                task.wait(2)
                            elseif shiftAttempts >= 3 then
                                setStatus("смену начать не удалось, едем к меткам")
                                shiftDone = true
                            end
                        end
                    else
                        shiftDone = true
                    end
                end

            else
                local ignore = nil
                if lastDone and os.clock() - lastDone.t < 8 then
                    ignore = lastDone.pos
                end

                local best, dist, _, instr, hud = findTaxiTarget(ignore)

                if not best then
                    if hud and not ignore then
                        setStatus("метка не найдена, на экране " .. hud .. " м (жми ДАМП)")
                    else
                        setStatus("жду следующий заказ")
                    end
                    task.wait(1)
                else
                    local isPickup = instr and instr:find("Забери", 1, true)
                    local label = isPickup and "пассажир" or "высадка"

                    setStatus(label .. ": " .. math.floor(dist) .. " ст.")
                    debugLabel.Text = "цель: " .. best.kind .. " / " .. best.obj.Name
                        .. "\nна экране: " .. tostring(hud) .. " м"

                    local firstKey = instr and normText(instr) or ""
                    local hadHud = hud ~= nil
                    local watcher = makeWatcher(best, firstKey, hadHud)

                    local reached, reason = travelTo(best.pos, myCycle, 6, watcher)

                    -- долетели, сигнала нет: ждём недолго, потом ближе к центру кольца
                    if reached and not reason and alive(myCycle) then
                        reason = waitSignal(watcher, 3, myCycle)

                        if not reason and alive(myCycle) then
                            setStatus("ближе к центру кольца")
                            local reached2, reason2 = travelTo(best.pos, myCycle, 1.5, watcher)
                            reason = reason2
                            if reached2 and not reason then
                                reason = waitSignal(watcher, 3, myCycle)
                            end
                        end
                    end

                    if reason then
                        if not isPickup then
                            cyclesCompleted += 1
                            cyclesLabel.Text = "Циклы: " .. cyclesCompleted
                        end
                        setStatus("OK: " .. reason)
                        debugLabel.Text = "сигнал: " .. reason
                        lastDone = {pos = best.pos, t = os.clock()}
                        task.wait(0.5)
                    elseif alive(myCycle) then
                        setStatus("сигнала нет, пробуем ещё")
                        task.wait(0.5)
                    end
                end
            end

            task.wait(0.1)
        end

        releaseAll()
    end

    ---------------- ДАМП-отчёт ----------------
    local function buildDump()
        local lines = {}
        local function add(s) table.insert(lines, s) end
        local root = getRoot()

        add("== пассажир ==")
        local model0, seat0 = getVehicle()
        if seat0 then
            add("в машине по SeatPart: " .. tostring(passengerInCar()))
            local cnt = 0
            for m, info in pairs(nonPlayerHumanoidModels(seat0.Position, 30)) do
                cnt += 1
                if cnt <= 10 then
                    local sp = info.hum.SeatPart
                    add(m:GetFullName() .. " | расстояние="
                        .. math.floor((info.root.Position - seat0.Position).Magnitude)
                        .. " | сидит=" .. tostring(sp and sp:GetFullName()))
                end
            end
            if cnt == 0 then add("рядом (30 ст.) нет персонажей с Humanoid") end
        else
            add("игрок не в машине")
        end

        add("== нафармленное: источник сейчас ==")
        add(tostring(farmInfo.src))
        local ls = player:FindFirstChild("leaderstats")
        if ls then
            for _, v in ipairs(ls:GetChildren()) do
                add("leaderstats." .. v.Name .. " = " .. tostring(v.Value))
            end
        else
            add("leaderstats нет")
        end

        add("== подписи на экране про опыт/хп/силу/уровень ==")
        local statWords = {"EXP", "XP", "exp", "xp", "Опыт", "опыт", "ХП", "хп", "HP",
            "Сила", "сила", "Уровень", "уровень"}
        local sc = 0
        pcall(function()
            for _, g in ipairs(player.PlayerGui:GetDescendants()) do
                if g:IsA("TextLabel") and not g:IsDescendantOf(gui)
                    and g.AbsoluteSize.X > 0 and guiVisible(g) and textHas(g.Text, statWords) then
                    sc += 1
                    if sc <= 25 then
                        add(g:GetFullName() .. " | " .. g.Text)
                    end
                end
            end
        end)

        add("== машина ==")
        if model0 then
            add("model=" .. model0:GetFullName())
            add("seat=" .. seat0:GetFullName() .. " | " .. seat0.ClassName)
            local cnt = 0
            for _ in pairs(collectNoclipParts(model0, seat0)) do cnt += 1 end
            add("деталей в наборе noclip: " .. cnt)
        else
            add("игрок не в машине")
        end

        add("== задание на экране ==")
        local instr, hud = readHud()
        add("текст: " .. tostring(instr))
        add("расстояние: " .. tostring(hud) .. " м")

        add("== кандидаты метки ==")
        local best, _, list = findTaxiTarget()
        for i, c in ipairs(list) do
            if i > 20 then break end
            add(string.format("%s%s | %s | %s | %d ст.",
                (c == best) and "[ВЫБРАНА] " or "",
                c.kind, c.obj:GetFullName(), c.obj.ClassName,
                math.floor(c.dist or flatDistance(c.pos))))
        end
        if #list == 0 then add("(пусто)") end

        add("== кнопки слева на экране ==")
        local w = viewportWidth()
        local bc = 0
        pcall(function()
            for _, b in ipairs(player.PlayerGui:GetDescendants()) do
                if b:IsA("GuiButton") and not b:IsDescendantOf(gui)
                    and b.AbsoluteSize.X > 0 and guiVisible(b) then
                    local cx = b.AbsolutePosition.X + b.AbsoluteSize.X / 2
                    if cx < w * 0.3 then
                        bc += 1
                        if bc <= 40 then
                            local txt = b:IsA("TextButton") and b.Text or ""
                            local img = b:IsA("ImageButton") and b.Image or ""
                            add(string.format("%s | %s | text=%s | img=%s | x=%d y=%d",
                                b:GetFullName(), b.ClassName, txt, img,
                                math.floor(b.AbsolutePosition.X), math.floor(b.AbsolutePosition.Y)))
                        end
                    end
                end
            end
        end)

        add("== prompt'ы в радиусе 200 ==")
        for _, o in ipairs(promptCache) do
            local part = o.Parent and getPromptPart(o)
            if part and root then
                local d = (part.Position - root.Position).Magnitude
                if d <= 200 then
                    add(string.format("%s | obj=%s | action=%s | %d",
                        o:GetFullName(), tostring(o.ObjectText),
                        tostring(o.ActionText), math.floor(d)))
                end
            end
        end

        add("== надписи над точками (BillboardGui) ==")
        local bb, n = 0, 0
        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                n += 1
                if n % 2000 == 0 then task.wait() end
                if obj:IsA("BillboardGui") then
                    local texts = billboardTexts(obj)
                    if #texts > 0 then
                        local pos = billboardPos(obj)
                        local d = pos and math.floor(flatDistance(pos)) or -1
                        if d == -1 or d <= 400 then
                            bb += 1
                            if bb <= 30 then
                                add(string.format("%s | %s | enabled=%s | %d",
                                    obj:GetFullName(), table.concat(texts, " / "),
                                    tostring(obj.Enabled), d))
                            end
                        end
                    end
                end
            end
        end)

        add("== жёлтые неоновые детали рядом (до 200 стадов) ==")
        local yc = 0
        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Material == Enum.Material.Neon
                    and obj.Transparency < 1 and root and isYellow(obj.Color)
                    and (obj.Position - root.Position).Magnitude <= 200 then
                    yc += 1
                    if yc <= 20 then
                        add(obj:GetFullName() .. " | " .. obj.ClassName
                            .. " | size=" .. tostring(obj.Size)
                            .. " | " .. math.floor((obj.Position - root.Position).Magnitude))
                    end
                end
            end
        end)

        add("== атрибуты игрока ==")
        for k, v in pairs(player:GetAttributes()) do
            add(tostring(k) .. " = " .. tostring(v))
        end

        return table.concat(lines, "\n")
    end

    dumpButton.MouseButton1Click:Connect(function()
        dumpButton.Text = "собираю отчёт..."
        task.spawn(function()
            if #promptCache == 0 then scanPrompts() end
            local ok, text = pcall(buildDump)
            if not ok then
                dumpButton.Text = "ДАМП: ошибка"
                return
            end
            if typeof(setclipboard) == "function" then
                pcall(setclipboard, text)
                dumpButton.Text = "ДАМП скопирован!"
            else
                print(text)
                dumpButton.Text = "ДАМП в консоли (F9)"
            end
            task.wait(3)
            dumpButton.Text = "ДАМП (скопировать отчёт)"
        end)
    end)

    ---------------- общий цикл ----------------
    local function runLoop(myCycle)
        setStatus("ждём персонажа")
        local waited = 0
        while alive(myCycle) and not getRoot() do
            task.wait(0.5)
            waited += 0.5
            if waited > 30 then
                setStatus("персонаж не появился")
                return
            end
        end
        if not alive(myCycle) then return end

        setStatus("сканируем карту")
        scanPrompts()
        updateDebug()

        if mode == "taxi" then
            taxiLoop(myCycle)
        else
            treadmillLoop(myCycle)
        end
    end

    local function launch()
        releaseAll()
        cycleId += 1
        local myCycle = cycleId
        task.spawn(function()
            local ok, err = pcall(runLoop, myCycle)
            if not ok then
                releaseAll()
                status.Text = "Ошибка: " .. tostring(err):sub(1, 50)
            end
        end)
    end

    modeButton.MouseButton1Click:Connect(function()
        if mode == "treadmill" then
            mode = "taxi"
            modeButton.Text = "Режим: Такси"
        else
            mode = "treadmill"
            modeButton.Text = "Режим: Дорожка"
        end
        if enabled then
            launch()
        else
            releaseAll()
        end
    end)

    driveButton.MouseButton1Click:Connect(function()
        flyMode = not flyMode
        driveButton.Text = flyMode and "Езда: полёт" or "Езда: земля"
    end)

    toggle.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            toggle.Text = "ПАУЗА"
            launch()
        else
            cycleId += 1
            releaseAll()
            toggle.Text = "ПРОДОЛЖИТЬ"
            timer.Text = "Таймер: пауза"
            setStatus("пауза")
        end
    end)

    player.CharacterAdded:Connect(function()
        if enabled then launch() end
    end)

    -- счётчик нафармленного работает всегда, раз в секунду
    task.spawn(function()
        while gui.Parent do
            pcall(trackFarm)
            task.wait(1)
        end
    end)

    launch()
end

