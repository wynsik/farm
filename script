    ---------------- подсчёт нафармленного ----------------
    local lastStat = nil

    local function textHas(s, words)
        s = tostring(s or "")
        for _, w in ipairs(words) do
            if s:find(w, 1, true) then return true end
        end
        return false
    end

    local function statMatches(n)
        if STAT_NAME then return n == STAT_NAME end
        local l = n:lower()
        for _, w in ipairs(STAT_WORDS) do
            if n:find(w, 1, true) or l:find(w, 1, true) then return true end
        end
        return false
    end

    local function readStat()
        local ls = player:FindFirstChild("leaderstats")
        if ls then
            for _, v in ipairs(ls:GetChildren()) do
                if (v:IsA("IntValue") or v:IsA("NumberValue")) and statMatches(v.Name) then
                    return v.Value, "leaderstats." .. v.Name
                end
            end
        end
        for k, v in pairs(player:GetAttributes()) do
            if type(v) == "number" and statMatches(k) then
                return v, "атрибут " .. k
            end
        end
        return nil, nil
    end

    local function trackFarm()
        local onT = false
        if mode == "treadmill" and enabled then
            local p = searchCache()
            onT = p ~= nil and p.ActionText == ACTION_STOP
        end
        farmInfo.on = onT

        local cur, name = readStat()
        local gained = 0

        if cur then
            farmInfo.src = "игра: " .. tostring(name)
            if lastStat and cur > lastStat and onT then
                gained = cur - lastStat
            end
            lastStat = cur
        else
            lastStat = nil
            farmInfo.src = "оценка " .. EXP_PER_SECOND .. "/сек"
            if onT then gained = EXP_PER_SECOND end
        end

        if gained > 0 then
            totalFarmed += gained
        end

        updateFarmLabel()
    end

    ---------------- режим: дорожка ----------------
    local function ensureRunning(myCycle)
        setStatus("ищем дорожку")
        local prompt = findPrompt()
        updateDebug()
        if not prompt then
            setStatus("дорожка не найдена (см. диагностику)")
            return false
        end
        if prompt.ActionText == ACTION_STOP then
            setStatus("уже бежит")
            return true
        end
        if not moveToPrompt(prompt, myCycle) then
            setStatus("не удалось дойти")
            return false
        end
        prompt = waitForAction(ACTION_RUN, 3, myCycle)
        if not prompt then return false end
        if not activatePrompt(prompt) then return false end
        setStatus("залез на дорожку")
        return true
    end

    local function reRun(myCycle)
        setStatus("слезаем...")
        local prompt = findPrompt()
        if not prompt then
            setStatus("дорожка не найдена")
            return false
        end
        if prompt.ActionText == ACTION_STOP then
            if not activatePrompt(prompt) then return false end
            prompt = waitForAction(ACTION_RUN, 5, myCycle)
            if not prompt then
                setStatus("слезть не удалось")
                return false
            end
        end
        if not alive(myCycle) then return false end

        setStatus("залезаем...")
        if not moveToPrompt(prompt, myCycle) then
            setStatus("не удалось подойти")
            return false
        end
        prompt = waitForAction(ACTION_RUN, 3, myCycle)
        if prompt and activatePrompt(prompt) then
            setStatus("перезапущено")
            return true
        end
        setStatus("перезапуск не удался")
        return false
    end

    local function treadmillLoop(myCycle)
        while alive(myCycle) do
            if ensureRunning(myCycle) then break end
            task.wait(3)
        end

        while alive(myCycle) do
            local remaining = INTERVAL
            while alive(myCycle) and remaining > 0 do
                timer.Text = string.format("Таймер: %02d:%02d",
                    math.floor(remaining / 60), remaining % 60)
                if remaining % 5 == 0 then updateDebug() end
                task.wait(1)
                remaining -= 1
            end
            if not alive(myCycle) then break end

            if reRun(myCycle) then
                cyclesCompleted += 1
                cyclesLabel.Text = "Циклы: " .. cyclesCompleted
            else
                task.wait(2)
                ensureRunning(myCycle)
            end
        end
    end

    ---------------- такси: метки ----------------
    local function textMatches(t)
        for _, w in ipairs(TAXI_TEXT) do
            if t:find(w, 1, true) then return true end
        end
        return false
    end

    local function isYellow(c)
        return c.R > 0.8 and c.G > 0.65 and c.B < 0.45
    end

    local function objectPosition(obj)
        if not obj then return nil end
        if obj:IsA("BasePart") then
            return obj.Position
        elseif obj:IsA("Attachment") then
            return obj.WorldPosition
        elseif obj:IsA("Model") then
            local ok, cf = pcall(function() return obj:GetPivot() end)
            if ok then return cf.Position end
        end
        return nil
    end

    local function billboardPos(g)
        local p = objectPosition(g.Adornee)
        if p then return p end
        local cur = g.Parent
        for _ = 1, 4 do
            if not cur or cur == workspace then break end
            p = objectPosition(cur)
            if p then return p end
            cur = cur.Parent
        end
        return nil
    end

    local function billboardTexts(g)
        local out = {}
        for _, d in ipairs(g:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
                table.insert(out, d.Text)
            end
        end
        return out
    end

    local function normText(s)
        s = tostring(s or "")
        s = s:gsub("<[^>]+>", "")
        s = s:gsub("[%d%.,%s]+", "")
        return s
    end

    -- Задание на экране: текст и расстояние в метрах («9 м»)
    local function readHud()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if not pg then return nil, nil end

        local distLabel, dist
        for _, g in ipairs(pg:GetDescendants()) do
            if g:IsA("TextLabel") and not g:IsDescendantOf(gui)
                and g.AbsoluteSize.X > 0 and guiVisible(g) then
                local t = g.Text:gsub("<[^>]+>", "")
                local n = t:match("^%s*(%d+[%.,]?%d*)%s*м%s*$")
                if n then
                    distLabel = g
                    dist = tonumber((n:gsub(",", ".")))
                    break
                end
            end
        end
        if not distLabel then return nil, nil end

        local instr
        local cur = distLabel.Parent
        for _ = 1, 3 do
            if not cur then break end
            for _, d in ipairs(cur:GetDescendants()) do
                if d:IsA("TextLabel") and d ~= distLabel and guiVisible(d) then
                    local t = d.Text:gsub("<[^>]+>", "")
                    if #t > 12 and (not instr or #t > #instr) then
                        instr = t
                    end
                end
            end
            if instr then break end
            cur = cur.Parent
        end

        return instr, dist
    end

    -- ignorePos: только что выполненная точка, её пропускаем
    local function findTaxiTarget(ignorePos)
        local instr, hud = readHud()
        local want = instr and normText(instr) or nil
        local root = getRoot()
        local char = player.Character

        local exact, loose, yellow = {}, {}, {}
        local n = 0

        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                n += 1
                if n % 2000 == 0 then task.wait() end

                if obj:IsA("BillboardGui") then
                    if obj.Enabled then
                        local isExact, isLoose = false, false
                        for _, t in ipairs(billboardTexts(obj)) do
                            local nt = normText(t)
                            if want and #want > 8 and #nt > 8 then
                                if nt:find(want, 1, true)
                                    or (want:find(nt, 1, true) and #nt >= #want - 6) then
                                    isExact = true
                                end
                            end
                            if textMatches(t) then isLoose = true end
                        end
                        if isExact or isLoose then
                            local pos = billboardPos(obj)
                            if pos then
                                table.insert(isExact and exact or loose, {
                                    obj = obj,
                                    pos = pos,
                                    kind = isExact and "текст задания" or "слово",
                                })
                            end
                        end
                    end
                elseif obj:IsA("BasePart")
                    and obj.Material == Enum.Material.Neon
                    and obj.Transparency < 0.95
                    and isYellow(obj.Color)
                    and (obj.Size.X >= 12 or obj.Size.Z >= 12)
                    and not (char and obj:IsDescendantOf(char)) then
                    table.insert(yellow, obj)
                end
            end
        end)

        local list = exact
        if #list == 0 then list = loose end

        if #list == 0 and not hud then
            for _, p in ipairs(yellow) do
                local dup = false
                for _, c in ipairs(list) do
                    if (c.pos - p.Position).Magnitude < 15 then dup = true break end
                end
                if not dup then
                    table.insert(list, {obj = p, pos = p.Position, kind = "жёлтое кольцо"})
                end
            end
        end

        if ignorePos then
            local filtered = {}
            for _, c in ipairs(list) do
                if (c.pos - ignorePos).Magnitude >= 15 then
                    table.insert(filtered, c)
                end
            end
            list = filtered
        end

        if #list == 0 then
            return nil, nil, list, instr, hud
        end

        local best, bestErr
        for _, c in ipairs(list) do
            local d = root and (c.pos - root.Position).Magnitude or 0
            c.dist = d
            local err = d
            if hud then
                err = math.huge
                for _, k in ipairs({1, 0.28, 0.25}) do
                    err = math.min(err, math.abs(d * k - hud))
                end
            end
            if not bestErr or err < bestErr then
                best, bestErr = c, err
            end
        end

        best.instr = instr
        best.hud = hud
        return best, best.dist, list, instr, hud
    end

    ---------------- такси: машина ----------------
    local function getVehicle()
        local hum = getHumanoid()
        local seat = hum and hum.SeatPart
        if not seat then return nil, nil end
        local model = seat:FindFirstAncestorOfClass("Model") or seat
        return model, seat
    end

    local keyState = {}
    local lastThrottle = 0

    local function setKey(code, down)
        if keyState[code] == down then return end
        keyState[code] = down
        if VIM then
            pcall(function() VIM:SendKeyEvent(down, code, false, game) end)
        end
    end

    local function drive(throttle, steer)
        lastThrottle = throttle
        setKey(Enum.KeyCode.W, throttle > 0.1)
        setKey(Enum.KeyCode.S, throttle < -0.1)
        setKey(Enum.KeyCode.A, steer < -0.25)
        setKey(Enum.KeyCode.D, steer > 0.25)

        local _, seat = getVehicle()
        if seat and seat:IsA("VehicleSeat") then
            pcall(function()
                seat.Throttle = throttle > 0.1 and 1 or (throttle < -0.1 and -1 or 0)
                seat.Steer = steer > 0.25 and 1 or (steer < -0.25 and -1 or 0)
            end)
        end
    end

    local function releaseAll()
        for code, down in pairs(keyState) do
            if down then
                keyState[code] = false
                if VIM then
                    pcall(function() VIM:SendKeyEvent(false, code, false, game) end)
                end
            end
        end
        local _, seat = getVehicle()
        if seat and seat:IsA("VehicleSeat") then
            pcall(function()
                seat.Throttle = 0
                seat.Steer = 0
            end)
        end
        lastThrottle = 0
    end

    local function listSeats()
        local set, n = {}, 0
        pcall(function()
            for _, o in ipairs(workspace:GetDescendants()) do
                n += 1
                if n % 2000 == 0 then task.wait() end
                if o:IsA("VehicleSeat") then set[o] = true end
            end
        end)
        return set
    end

    local function seatIsMine(seat)
        local pname = player.Name:lower()
        local dname = player.DisplayName:lower()
        local cur = seat
        while cur and cur ~= workspace do
            local nm = cur.Name:lower()
            if nm:find(pname, 1, true) or nm:find(dname, 1, true) then return true end
            for _, v in pairs(cur:GetAttributes()) do
                if v == player.UserId or v == player.Name then return true end
            end
            for _, c in ipairs(cur:GetChildren()) do
                if (c:IsA("ObjectValue") and c.Value == player)
                    or (c:IsA("StringValue") and c.Value == player.Name)
                    or (c:IsA("IntValue") and c.Value == player.UserId) then
                    return true
                end
            end
            cur = cur.Parent
        end
        return false
    end

    local function findCarButton()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if not pg then return nil end
        local w = viewportWidth()

        for _, b in ipairs(pg:GetDescendants()) do
            if b:IsA("GuiButton") and not b:IsDescendantOf(gui)
                and b.AbsoluteSize.X > 0 and guiVisible(b) then

                local matched = false
                if CAR_BUTTON_NAME then
                    matched = (b.Name == CAR_BUTTON_NAME)
                else
                    local cx = b.AbsolutePosition.X + b.AbsoluteSize.X / 2
                    if cx < w * 0.3 then
                        local hay = b.Name
                        if b:IsA("TextButton") then hay = hay .. " " .. b.Text end
                        if b.Parent then hay = hay .. " " .. b.Parent.Name end
                        local low = hay:lower()
                        for _, p in ipairs(CAR_PATTERNS_LATIN) do
                            if low:find(p) then matched = true break end
                        end
                        if not matched then
                            for _, p in ipairs(CAR_PATTERNS_PLAIN) do
                                if low:find(p, 1, true) then matched = true break end
                            end
                        end
                    end
                end

                if matched then return b end
            end
        end
        return nil
    end

    local function waitNewSeat(before, timeout, myCycle)
        local t0 = os.clock()
        while alive(myCycle) and os.clock() - t0 < timeout do
            local now = listSeats()
            local best, bestD
            for s in pairs(now) do
                if not before[s] and not s.Occupant then
                    local d = flatDistance(s.Position)
                    if not bestD or d < bestD then best, bestD = s, d end
                end
            end
            if best then return best end
            task.wait(0.5)
        end
        return nil
    end

    local function boardSeat(seat, myCycle)
        local hum, root = getHumanoid(), getRoot()
        if not hum or not root or not seat or not seat.Parent then return false end

        setStatus("идём к машине")
        local pos = seat.Position
        if flatDistance(pos) < 120 then
            moveTo(pos, myCycle, function()
                return (root.Position - pos).Magnitude <= 6
            end)
        end
        if not alive(myCycle) then return false end

        for _ = 1, 3 do
            if hum.SeatPart then return true end
            pcall(function() seat:Sit(hum) end)
            task.wait(0.5)
            if hum.SeatPart then return true end
            root.CFrame = seat.CFrame * CFrame.new(0, 2.5, 0)
            task.wait(1)
        end

        return hum.SeatPart ~= nil
    end

    local function getCar(myCycle)
        local before = listSeats()

        for seat in pairs(before) do
            if not seat.Occupant and seatIsMine(seat) then
                setStatus("нашли свою машину")
                if boardSeat(seat, myCycle) then return true end
            end
        end

        local btn = findCarButton()
        if not btn then
            setStatus("кнопка машины не найдена, жми ДАМП")
            return false
        end

        setStatus("вызываем машину")
        fireButton(btn)
        local seat = waitNewSeat(before, 6, myCycle)

        if not seat and alive(myCycle) then
            setStatus("вызываем машину (клик)")
            vimClick(btn)
            seat = waitNewSeat(before, 8, myCycle)
        end

        if not seat then
            setStatus("машина не появилась")
            return false
        end

        return boardSeat(seat, myCycle)
    end

    ---------------- такси: езда по земле ----------------
    local function planPath(from, to)
        local pts = {}
        local path = PathfindingService:CreatePath({
            AgentRadius = 6,
            AgentHeight = 6,
            AgentCanJump = false,
            AgentCanClimb = false,
            WaypointSpacing = 14,
        })
        local ok = pcall(function() path:ComputeAsync(from, to) end)
        if ok and path.Status == Enum.PathStatus.Success then
            for i, wp in ipairs(path:GetWaypoints()) do
                if i > 1 then table.insert(pts, wp.Position) end
            end
        end
        if #pts == 0 then pts = {to} end
        return pts
    end

    -- Возвращает: доехали(bool), сигнал(строка или nil)
    local function driveTo(dest, myCycle, watcher)
        local _, seat = getVehicle()
        if not seat then return false end

        local fwdSign = 1
        local pts = planPath(seat.Position, dest)
        local idx = 1
        local lastPlan = os.clock()
        local started = os.clock()
        local stuckSince = nil
        local lastStatus = 0

        setStatus("едем к метке")

        while alive(myCycle) and os.clock() - started < 150 do
            local _, s = getVehicle()
            if not s then
                releaseAll()
                return false
            end
            seat = s

            local pos = seat.Position
            local vel = seat.AssemblyLinearVelocity
            local flatVel = Vector3.new(vel.X, 0, vel.Z)
            local speed = flatVel.Magnitude

            local lk = seat.CFrame.LookVector
            local look = Vector3.new(lk.X, 0, lk.Z)
            if look.Magnitude < 0.05 then
                task.wait(0.1)
                continue
            end
            look = look.Unit * fwdSign

            if speed > 12 and lastThrottle > 0 then
                if flatVel.Unit:Dot(look) < -0.5 then
                    fwdSign = -fwdSign
                    look = -look
                end
            end

            local distFinal = Vector3.new(pos.X - dest.X, 0, pos.Z - dest.Z).Magnitude

            -- рядом с кольцом следим за пассажиром
            if watcher and distFinal < 25 then
                local r = watcher()
                if r then
                    releaseAll()
                    return true, r
                end
            end

            if distFinal < 9 then
                local t0 = os.clock()
                while alive(myCycle) and os.clock() - t0 < 4 do
                    local _, s2 = getVehicle()
                    if not s2 then break end
                    if watcher then
                        local r = watcher()
                        if r then
                            releaseAll()
                            return true, r
                        end
                    end
                    local v2 = s2.AssemblyLinearVelocity
                    if Vector3.new(v2.X, 0, v2.Z).Magnitude < 2 then break end
                    drive(-1, 0)
                    task.wait(0.1)
                end
                releaseAll()
                return alive(myCycle)
            end

            if os.clock() - lastPlan > 15 then
                pts = planPath(pos, dest)
                idx = 1
                lastPlan = os.clock()
            end

            if idx < #pts then
                local w = pts[idx]
                if Vector3.new(pos.X - w.X, 0, pos.Z - w.Z).Magnitude < 14 then
                    idx += 1
                end
            end

            local tgt = pts[idx]
            local dir = Vector3.new(tgt.X - pos.X, 0, tgt.Z - pos.Z)
            if dir.Magnitude < 0.5 then
                dir = Vector3.new(dest.X - pos.X, 0, dest.Z - pos.Z)
            end
            dir = dir.Unit

            local cross = look.Z * dir.X - look.X * dir.Z
            local dot = look:Dot(dir)
            local steer = math.clamp(-cross * 2.5, -1, 1)
            if dot < 0 then
                steer = (cross >= 0) and -1 or 1
            end

            local maxSpeed = math.clamp(distFinal * 0.8, 12, 70)
            if dot < 0.3 then maxSpeed = math.min(maxSpeed, 25) end

            local throttle = 1
            if speed > maxSpeed + 6 then
                throttle = -1
            elseif speed > maxSpeed then
                throttle = 0
            end

            if throttle > 0 and speed < 2 then
                stuckSince = stuckSince or os.clock()
                if os.clock() - stuckSince > 2.5 then
                    setStatus("застряли, сдаём назад")
                    local t0 = os.clock()
                    while alive(myCycle) and os.clock() - t0 < 1.6 do
                        drive(-1, -steer)
                        task.wait(0.1)
                    end
                    drive(0, 0)
                    pts = planPath(seat.Position, dest)
                    idx = 1
                    lastPlan = os.clock()
                    stuckSince = nil
                    setStatus("едем к метке")
                end
            else
                stuckSince = nil
            end

            drive(throttle, steer)

            if os.clock() - lastStatus > 1 then
                lastStatus = os.clock()
                setStatus("едем: " .. math.floor(distFinal) .. " м")
            end

            task.wait(0.1)
        end

        releaseAll()
        return false
    end

    ---------------- такси: полёт (сквозь стены, низко над дорогой) ----------------
    local NPC_RADIUS = 20

    local function isOtherPlayerChar(m)
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.Character == m then return true end
        end
        return false
    end

    local function collectNoclipParts(model, seat)
        local set = {}

        local function addTree(root)
            if not root then return end
            if root:IsA("BasePart") then set[root] = true end
            for _, p in ipairs(root:GetDescendants()) do
                if p:IsA("BasePart") then set[p] = true end
            end
        end

        addTree(model)
        addTree(player.Character)

        if seat then
            pcall(function()
                for _, p in ipairs(seat:GetConnectedParts(true)) do
                    set[p] = true
                end
            end)

            pcall(function()
                local near = workspace:GetPartBoundsInRadius(seat.Position, NPC_RADIUS)
                local seen = {}
                for _, p in ipairs(near) do
                    local m = p:FindFirstAncestorOfClass("Model")
                    if m and not seen[m] then
                        seen[m] = true
                        local h = m:FindFirstChildOfClass("Humanoid")
                        if h and not isOtherPlayerChar(m) and m ~= player.Character then
                            local sp = h.SeatPart
                            if sp and (sp == seat or (model and sp:IsDescendantOf(model))) then
                                addTree(m)
                            end
                        end
                    end
                end
            end)
        end

        return set
    end

    local function refreshNoclip(model, seat, set, store)
        local fresh = collectNoclipParts(model, seat)
        for p in pairs(fresh) do
            if not set[p] then
                set[p] = true
                if store[p] == nil then store[p] = p.CanCollide end
            end
        end
    end

    local function restoreNoclip(store)
        for p, was in pairs(store) do
            if p.Parent then
                pcall(function() p.CanCollide = was end)
            end
        end
    end

    local function groundBelow(pos, ignore, up, len)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = ignore
        pcall(function() params.RespectCanCollide = true end)
        local res = workspace:Raycast(
            pos + Vector3.new(0, up, 0),
            Vector3.new(0, -len, 0),
            params
        )
        return res and res.Position.Y or nil
    end

    -- Возвращает: долетели(bool), сигнал(строка или nil)
    local function flyTo(dest, myCycle, radius, watcher)
        local model, seat = getVehicle()
        if not seat then return false end

        releaseAll()
        radius = radius or 6

        local store = {}
        local noclipSet = {}
        local arrived = false
        local signal = nil

        local conn = RunService.Stepped:Connect(function()
            for p in pairs(noclipSet) do
                if p.Parent and p.CanCollide then
                    p.CanCollide = false
                end
            end
        end)

        local ok = pcall(function()
            local ignore = {model, player.Character}
            local destGround = groundBelow(dest, ignore, 60, 300) or dest.Y
            local lastGround = groundBelow(seat.Position, ignore, 4, 40) or seat.Position.Y

            refreshNoclip(model, seat, noclipSet, store)

            local started = os.clock()
            local lastStatus = 0
            local lastNoclip = os.clock()

            while alive(myCycle) and os.clock() - started < 90 do
                local m, s = getVehicle()
                if not s then return end

                if os.clock() - lastNoclip > 0.3 then
                    lastNoclip = os.clock()
                    refreshNoclip(m, s, noclipSet, store)
                end

                local pos = s.Position
                local flat = Vector3.new(dest.X - pos.X, 0, dest.Z - pos.Z)
                local d = flat.Magnitude

                -- рядом с кольцом следим за пассажиром
                if watcher and d < 22 then
                    local r = watcher()
                    if r then
                        signal = r
                        arrived = true
                        break
                    end
                end

                if d < radius then
                    arrived = true
                    break
                end

                local dir = flat.Unit

                local g = groundBelow(pos, ignore, 4, 40)
                if g then lastGround = g end
                local yWant = lastGround + FLY_HEIGHT
                if d < 25 then
                    yWant = destGround + FLY_HEIGHT
                end

                local spd = math.clamp(d * 1.5, 18, 95)
                local vy = math.clamp((yWant - pos.Y) * 6, -60, 60)

                s.AssemblyLinearVelocity = dir * spd + Vector3.new(0, vy, 0)
                s.AssemblyAngularVelocity = Vector3.zero

                pcall(function()
                    local p = m:GetPivot().Position
                    m:PivotTo(CFrame.lookAt(p, p + dir))
                end)

                if os.clock() - lastStatus > 1 then
                    lastStatus = os.clock()
                    setStatus("летим: " .. math.floor(d) .. " ст.")
                end

                RunService.Heartbeat:Wait()
            end
        end)

        conn:Disconnect()

        local _, s0 = getVehicle()
        if s0 then
            pcall(function()
                s0.AssemblyLinearVelocity = Vector3.zero
                s0.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        restoreNoclip(store)

        if not ok then
            setStatus("ошибка полёта")
            return false
        end
        if signal then
            return true, signal
        end
        if not arrived then
            return false
        end

        -- стоим в кольце, но выходим сразу, как только увидели сигнал
        setStatus("стоим в кольце")
        local t0 = os.clock()
        while alive(myCycle) and os.clock() - t0 < 1.5 do
            local _, s = getVehicle()
            if not s then return false end

            if watcher then
                local r = watcher()
                if r then return true, r end
            end

            local v = s.AssemblyLinearVelocity
            s.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
            s.AssemblyAngularVelocity = Vector3.zero
            RunService.Heartbeat:Wait()
        end

        return alive(myCycle), nil
    end

    local function travelTo(dest, myCycle, radius, watcher)
        if flyMode then
            return flyTo(dest, myCycle, radius, watcher)
        end
        return driveTo(dest, myCycle, watcher)
    end

