-- АВТО-СМЕНА СЕРВЕРА, если зашёл нежелательный игрок
----------------------------------------------------------------
local BLOCKED_NAMES = {"tommy_boblox"} -- маленькими буквами, можно добавлять ещё

local function isBlocked(pl)
    local n = pl.Name:lower()
    local d = pl.DisplayName:lower()
    for _, b in ipairs(BLOCKED_NAMES) do
        if n == b or d == b then return true end
    end
    return false
end

local hopping = false
local function serverHop()
    if hopping then return end
    hopping = true

    local ok = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))

        local list = {}
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers - 1 then
                table.insert(list, s.id)
            end
        end

        if #list == 0 then error("нет серверов") end
        TeleportService:TeleportToPlaceInstance(game.PlaceId, list[math.random(#list)], player)
    end)

    if not ok then
        TeleportService:Teleport(game.PlaceId, player)
    end

    task.delay(10, function() hopping = false end)
end

for _, pl in ipairs(Players:GetPlayers()) do
    if pl ~= player and isBlocked(pl) then serverHop() end
end

Players.PlayerAdded:Connect(function(pl)
    if isBlocked(pl) then serverHop() end
end)

