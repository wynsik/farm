----------------------------------------------------------------
-- ОСНОВНАЯ ЛОГИКА
----------------------------------------------------------------
local function main()
    local function getRoot()
        local c = player.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function getHumanoid()
        local c = player.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end

    local function getPromptPart(prompt)
        local part = prompt.Parent
        if part and part:IsA("Attachment") then part = part.Parent end
        if part and part:IsA("BasePart") then return part end
        return nil
    end

    local function alive(c) return enabled and cycleId == c end

    ---------------- кэш prompt'ов ----------------
    local promptCache = {}
    local lastScan = 0
    local scanning = false

    local function scanPrompts()
        if scanning then return end
        scanning = true
        local list, n = {}, 0
        local ok = pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                n += 1
                if n % 2000 == 0 then task.wait() end
                if obj:IsA("ProximityPrompt") then
                    table.insert(list, obj)
                end
            end
        end)
        if ok then promptCache = list end
        lastScan = os.clock()
        scanning = false
    end

    local function searchCacheBy(pred)
        local root = getRoot()
        if not root then return nil end
        local nearest, best = nil, math.huge
        for _, obj in ipairs(promptCache) do
            if obj.Parent and obj.Enabled and pred(obj) then
                local part = getPromptPart(obj)
                if part then
                    local d = (part.Position - root.Position).Magnitude
                    if d < best then best, nearest = d, obj end
                end
            end
        end
        return nearest
    end

    local function isTreadmill(o)
        return o.ActionText == ACTION_RUN or o.ActionText == ACTION_STOP
    end

    local function searchCache()
        return searchCacheBy(isTreadmill)
    end

    local function findPromptBy(pred)
        if os.clock() - lastScan > 10 then scanPrompts() end
        local r = searchCacheBy(pred)
        if not r and os.clock() - lastScan > 2 then
            scanPrompts()
            r = searchCacheBy(pred)
        end
        return r
    end

    local function findPrompt()
        return findPromptBy(isTreadmill)
    end

    local function updateDebug()
        local root = getRoot()
        local text = "prompt'ов в игре: " .. #promptCache
        if root then
            local best, bestD
            for _, obj in ipairs(promptCache) do
                local part = obj.Parent and getPromptPart(obj)
                if part then
                    local d = (part.Position - root.Position).Magnitude
                    if not bestD or d < bestD then
                        best, bestD = obj, d
                    end
                end
            end
            if best then
                text = text .. "\nближайший: «" .. tostring(best.ActionText)
                    .. "» " .. math.floor(bestD) .. " стадов"
            end
        end
        debugLabel.Text = text
    end

    ---------------- действия пешком ----------------
    local function activatePrompt(prompt)
        if not prompt or not prompt.Parent then return false end
        if typeof(fireproximityprompt) ~= "function" then
            setStatus("executor не поддерживает fireproximityprompt")
            return false
        end
        local ok, err = pcall(fireproximityprompt, prompt)
        if not ok then setStatus("ошибка: " .. tostring(err):sub(1, 30)) end
        return ok
    end

    local function inRange(prompt)
        local root, part = getRoot(), getPromptPart(prompt)
        if not root or not part then return false end
        return (part.Position - root.Position).Magnitude
            <= math.max(prompt.MaxActivationDistance - 1, 4)
    end

    local function flatDistance(pos)
        local root = getRoot()
        if not root then return math.huge end
        return Vector3.new(root.Position.X - pos.X, 0, root.Position.Z - pos.Z).Magnitude
    end

    local function walkTo(pos, myCycle, timeout)
        local hum = getHumanoid()
        if not hum or not getRoot() then return false end
        hum:MoveTo(pos)
        local t0 = os.clock()
        while os.clock() - t0 < timeout do
            if not alive(myCycle) or hum.Health <= 0 then return false end
            if flatDistance(pos) <= 4 then return true end
            task.wait(0.1)
        end
        return false
    end

    local function moveTo(target, myCycle, doneFn)
        local root, hum = getRoot(), getHumanoid()
        if not root or not hum then return false end
        if doneFn() then return true end

        local path = PathfindingService:CreatePath({AgentCanJump = true})
        local computed = pcall(function() path:ComputeAsync(root.Position, target) end)

        if computed and path.Status == Enum.PathStatus.Success then
            for i, wp in ipairs(path:GetWaypoints()) do
                if not alive(myCycle) then return false end
                if i > 1 then
                    if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
                    if not walkTo(wp.Position, myCycle, 4) then break end
                    if doneFn() then return true end
                end
            end
        end

        if alive(myCycle) then walkTo(target, myCycle, 6) end
        return alive(myCycle) and doneFn()
    end

    local function moveToPrompt(prompt, myCycle)
        if not prompt or not prompt.Parent then return false end
        local target = getPromptPart(prompt)
        if not target then return false end
        return moveTo(target.Position, myCycle, function() return inRange(prompt) end)
    end

    local function waitForAction(action, timeout, myCycle)
        local t0 = os.clock()
        repeat
            if not alive(myCycle) then return nil end
            local p = searchCache()
            if p and p.ActionText == action then return p end
            task.wait(0.2)
        until os.clock() - t0 >= timeout
        return nil
    end

    ---------------- GUI-хелперы ----------------
    local function guiVisible(g)
        local cur = g
        local pg = player:FindFirstChildOfClass("PlayerGui")
        while cur and cur ~= pg do
